---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Setiawan Joddy"
  description="Contact Setiawan Joddy about AI products, research partnerships, and product leadership roles."
>
  <section class="page-shell page-intro">
    <p class="eyebrow">Contact / Start here</p>
    <h1>Let’s work on something useful.</h1>
    <p class="intro-copy">
      I’m open to industry partnerships, academic collaborations, product conversations, and
      Product Manager and AI Product Manager opportunities.
    </p>
  </section>

  <section class="page-shell contact-grid">
    <div>
      <p class="index">Best first step</p>
      <h2>Send a short note on LinkedIn.</h2>
      <p>Tell me what you are building, researching, or hiring for and why you think we should talk.</p>
      <a
        class="button"
        href="https://linkedin.com/in/setiawanjoddy"
        target="_blank"
        rel="noreferrer"
      >Message me on LinkedIn</a>
    </div>

    <div class="contact-reasons">
      <p class="index">Good reasons to reach out</p>
      <ul>
        <li>Build or shape an AI-enabled product</li>
        <li>Develop an industry–academic partnership</li>
        <li>Collaborate on applied AI research</li>
        <li>Discuss a product leadership role</li>
      </ul>
    </div>
  </section>

  <nav class="page-shell profile-links" aria-label="External profiles">
    <a href="https://linkedin.com/in/setiawanjoddy" target="_blank" rel="noreferrer">
      <span>Professional profile</span><strong>LinkedIn</strong>
    </a>
    <a href="https://github.com/setiawanjoddy" target="_blank" rel="noreferrer">
      <span>Code and experiments</span><strong>GitHub</strong>
    </a>
    <a
      href="https://scholar.google.com/citations?user=PbCs3nkAAAAJ&hl=en"
      target="_blank"
      rel="noreferrer"
    >
      <span>Research record</span><strong>Google Scholar</strong>
    </a>
  </nav>
</BaseLayout>
