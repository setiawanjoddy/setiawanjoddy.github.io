---
import BaseLayout from "../layouts/BaseLayout.astro";

const roles = [
  {
    period: "2024 — Now",
    role: "Internationalization & Partnership Officer",
    organization: "BINUS University",
    detail: "Matchmaker between programs, partners, and opportunities — product partnerships with campuses.",
  },
  {
    period: "Now",
    role: "Assistant Professor",
    organization: "School of Computer Science, BINUS University",
    detail: "Taught AI and software engineering by making students build real things, not just pass exams.",
  },
  {
    period: "Product",
    role: "Associate Product Manager",
    organization: "EdenFarm",
    detail: "Turned muddy field operations into clear product direction for agritech.",
  },
  {
    period: "2020",
    role: "Product Manager & iOS Developer",
    organization: "Apple Developer Academy @BINUS",
    detail: "Shipped scrappy iOS apps in cross-functional teams at startup speed.",
  },
  {
    period: "Earlier",
    role: "QA Engineer / Product Management Officer",
    organization: "RCTI+ · MNC Group",
    detail: "Learned quality and delivery the hard way: inside a consumer media machine.",
  },
];
---

<BaseLayout
  title="Experience | Setiawan Joddy"
  description="Setiawan Joddy's gigs across product, AI builds, and creative chaos."
>
  <section class="page-shell page-intro">
    <p class="eyebrow">Experience / Gigs &amp; adventures</p>
    <h1>Gigs &amp; joyrides.</h1>
    <p class="intro-copy">
      A career built by jumping between worlds and stealing the best tricks from each.
    </p>
  </section>

  <section class="page-shell timeline" aria-label="Professional experience">
    {
      roles.map((item, index) => (
        <article class="timeline-item">
          <p class="index">0{index + 1} / {item.period}</p>
          <div>
            <h2>{item.role}</h2>
            <p class="organization">{item.organization}</p>
            <p>{item.detail}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="page-shell closing-callout">
    <p class="index">What comes next</p>
    <h2>I want gigs where the tech is deep and the meetings are short.</h2>
    <a class="button" href="/contact">Pitch me something fun</a>
  </section>
</BaseLayout>
