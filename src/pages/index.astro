---
import { Image } from "astro:assets";
import portrait from "../assets/profile-setiawanjoddy.jpeg";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Setiawan Joddy | AI Researcher & Product Leader"
  description="Setiawan Joddy is an AI educator, researcher, and product leader turning technical ideas into practical products."
>
  <section class="hero page-shell">
    <p class="eyebrow">AI educator · researcher · product leader</p>
    <div class="hero-grid">
      <h1>I turn AI research into products people can use.</h1>
      <figure class="hero-portrait">
        <Image
          src={portrait}
          alt="Portrait of Setiawan Joddy"
          class="hero-portrait-image"
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 48rem) calc(100vw - 2.5rem), 28vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <div class="hero-summary">
        <p>
          I connect rigorous research, product thinking, and education to move useful ideas from
          papers into the real world.
        </p>
        <div class="actions">
          <a class="button" href="/contact">Start a conversation</a>
          <a class="text-link" href="/projects">See selected work</a>
        </div>
      </div>
    </div>
  </section>

  <aside class="proof-strip" aria-label="Professional highlights">
    <div class="page-shell proof-grid">
      <p><strong>Assistant Professor</strong><span>School of Computer Science, BINUS</span></p>
      <p><strong>13 publications</strong><span>Across applied AI research</span></p>
      <p><strong>Product practice</strong><span>Agritech, media, and iOS</span></p>
    </div>
  </aside>

  <section class="page-shell section-grid">
    <div class="section-heading">
      <p class="index">01 / Practice</p>
      <h2>Three lenses. One practice.</h2>
    </div>
    <div class="lens-list">
      <article>
        <p class="index">Research</p>
        <h3>Find signal in complexity.</h3>
        <p>Applied machine learning across forecasting, language, security, and bioinformatics.</p>
      </article>
      <article>
        <p class="index">Product</p>
        <h3>Turn uncertainty into direction.</h3>
        <p>Frame the problem, align people, and move from evidence to a product decision.</p>
      </article>
      <article>
        <p class="index">Education</p>
        <h3>Make technical ideas travel.</h3>
        <p>Teach future builders to connect sound engineering with human needs.</p>
      </article>
    </div>
  </section>

  <section class="page-shell work-section">
    <div class="section-heading">
      <p class="index">02 / Proof</p>
      <h2>Selected work</h2>
    </div>
    <div class="work-list">
      <a class="work-item" href="/projects/joey">
        <span class="work-number">01</span>
        <span>
          <strong>Joey: Self-Care Buddy</strong>
          <small>Product strategy · iOS · augmented reality</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
      <a class="work-item" href="/publications">
        <span class="work-number">02</span>
        <span>
          <strong>Applied AI research</strong>
          <small>Forecasting · NLP · cybersecurity · bioinformatics</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a class="text-link" href="/publications">Explore the research</a>
  </section>

  <section class="closing-callout page-shell">
    <p class="index">Open to the right problem</p>
    <h2>Building an AI product, research partnership, or ambitious team?</h2>
    <a class="button" href="/contact">Let’s talk</a>
  </section>
</BaseLayout>
