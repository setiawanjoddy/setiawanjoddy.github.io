---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Setiawan Joddy | AI Builder & Product Maker"
  description="Setiawan Joddy builds AI-powered products with loud ideas and working software."
>
  <section class="hero page-shell">
    <p class="eyebrow">AI builder · product maker · professional tinkerer</p>
    <div class="hero-grid">
      <h1>I build AI stuff people actually use.</h1>
      <div class="hero-summary">
        <p class="sticker">★ open for fun projects</p>
        <p>
          I mix machine learning, product instincts, and heavy tinkering to ship things that
          survive contact with real humans.
        </p>
        <div class="actions">
          <a class="button" href="/contact">Start a project</a>
          <a class="text-link" href="/projects">See the goods</a>
        </div>
      </div>
    </div>
  </section>

  <aside class="proof-strip" aria-label="Builder highlights">
    <div class="page-shell proof-grid">
      <p><strong>Product builder</strong><span>Shipped across agritech, media &amp; iOS</span></p>
      <p><strong>13 research drops</strong><span>Experiments, with receipts</span></p>
      <p><strong>Zero-to-one energy</strong><span>Napkin sketch to launch</span></p>
    </div>
  </aside>

  <section class="page-shell section-grid">
    <div class="section-heading">
      <p class="index">01 / Playbook</p>
      <h2>Three moves. Zero fluff.</h2>
    </div>
    <div class="lens-list">
      <article>
        <p class="index">Build</p>
        <h3>Make the thing.</h3>
        <p>Prototype fast with real models and real data. No slideware, no vaporware.</p>
      </article>
      <article>
        <p class="index">Ship</p>
        <h3>Put it in people's hands.</h3>
        <p>Launch early, watch closely, and fix what actually hurts.</p>
      </article>
      <article>
        <p class="index">Teach</p>
        <h3>Show the next builder.</h3>
        <p>Turn hard-won lessons into shortcuts for other humans.</p>
      </article>
    </div>
  </section>

  <section class="page-shell work-section">
    <div class="section-heading">
      <p class="index">02 / Proof</p>
      <h2>Fresh from the lab</h2>
    </div>
    <div class="work-list">
      <a class="work-item" href="/projects/joey">
        <span class="work-number">01</span>
        <span>
          <strong>Joey: Self-Care Buddy</strong>
          <small>Product strategy · iOS · augmented reality</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
      <a class="work-item" href="/publications">
        <span class="work-number">02</span>
        <span>
          <strong>Applied AI research</strong>
          <small>Forecasting · NLP · cybersecurity · bioinformatics</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a class="text-link" href="/publications">Dig the archive</a>
  </section>

  <section class="closing-callout page-shell">
    <p class="index">Open for fun problems</p>
    <h2>Got a wild idea? Let's build it loud.</h2>
    <a class="button" href="/contact">Say hello</a>
  </section>
</BaseLayout>
