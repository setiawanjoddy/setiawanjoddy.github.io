---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: (typeof projects)[number];
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} | Setiawan Joddy`} description={project.summary}>
  <article class="page-shell case-study">
    <header class="case-header">
      <p class="eyebrow">Case study / {project.year}</p>
      <h1>{project.title}</h1>
      <p class="intro-copy">{project.summary}</p>
      <p class="case-label">{project.label}</p>
    </header>

    <div class="case-body">
      <section>
        <p class="index">01</p>
        <h2>The challenge</h2>
        <p>{project.challenge}</p>
      </section>
      <section>
        <p class="index">02</p>
        <h2>My role</h2>
        <p>{project.role}</p>
      </section>
      <section>
        <p class="index">03</p>
        <h2>What we built</h2>
        <p>{project.built}</p>
      </section>
      <aside>
        <p class="index">What stayed with me</p>
        <p>{project.learned}</p>
      </aside>
    </div>

    <a class="text-link" href="/projects">Back to all projects</a>
  </article>
</BaseLayout>
