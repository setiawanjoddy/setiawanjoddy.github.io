---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
---

<BaseLayout
  title="Projects | Setiawan Joddy"
  description="Shipped products, iOS apps, and machine learning builds by Setiawan Joddy."
>
  <section class="page-head">
    <div class="page-shell">
      <p class="eyebrow">Projects / The shelf</p>
      <h1>Things <span class="hl-pink">I shipped.</span></h1>
      <p class="intro-copy">
        A shelf of stuff I <strong>actually finished</strong>: apps, models, and experiments. Each
        one started with a question worth answering before building.
      </p>
    </div>
  </section>

  <section class="page-shell body-section">
    <div class="project-index" aria-label="Selected projects">
      {
        projects.map((project, index) => (
          <a class="project-row" href={`/projects/${project.slug}`}>
            <span class="project-number">0{index + 1}</span>
            <span class="project-copy">
              <small>{project.label}</small>
              <strong>{project.title}</strong>
              <span>{project.summary}</span>
            </span>
            <span class="project-year">{project.year}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
