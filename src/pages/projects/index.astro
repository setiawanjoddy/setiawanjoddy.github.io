---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
---

<BaseLayout
  title="Projects | Setiawan Joddy"
  description="Selected product, iOS, and machine learning projects by Setiawan Joddy."
>
  <section class="page-shell page-intro">
    <p class="eyebrow">Projects / Case studies</p>
    <h1>Products shaped by evidence.</h1>
    <p class="intro-copy">
      Selected work across product discovery, iOS, and applied machine learning. Each project began
      with a question worth clarifying before a solution worth building.
    </p>
  </section>

  <section class="page-shell project-index" aria-label="Selected projects">
    {
      projects.map((project, index) => (
        <a class="project-row" href={`/projects/${project.slug}`}>
          <span class="project-number">0{index + 1}</span>
          <span class="project-copy">
            <small>{project.label}</small>
            <strong>{project.title}</strong>
            <span>{project.summary}</span>
          </span>
          <span class="project-year">{project.year}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>
